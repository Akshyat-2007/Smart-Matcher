{
  "version": 2,
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install && npm --prefix server install && npm --prefix client install",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/seed/data/**",
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/scheduler/run",
      "schedule": "*/10 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
